.DS_Store

# Private recovery evidence. Keep locally; never add to public Git history.
webchat_raw_materials/

# External source originals are local by default. Rights-cleared release assets
# are published separately only after a recorded file-level license audit.
sources/library/**
!sources/library/README.md
sources/.staging/
tmp/

# Human-participant and sensitive research data never belongs in public Git.
data/human/
data/private/
data/identifiers/
artifacts/human/

# Raw AI provider payloads may contain licensed or human-derived inputs.
artifacts/ai/raw/
artifacts/runs/

# Generated research data is rebuilt from frozen inputs and manifests.
data/synthetic/generated/
data/derived/generated/

# Secrets and local environments.
.env
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
